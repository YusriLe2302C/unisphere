# College Virtual Hub (UniSphere) - Environment Variables
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/uniglobe_db
JWT_SECRET=replace_with_a_secure_random_key_in_production
AUDIT_HMAC_SECRET=replace_with_a_separate_random_key_at_least_32_characters
JWT_EXPIRES_IN=7d
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
ENABLE_ADMIN_DEMO=true
CROSS_COLLEGE_DEFAULT=true
